# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI Backend URL
VITE_BACKEND_URL=http://localhost:8000

# Mock Services Switch
# Set to 'true' to develop UI offline with realistic mock data and simulated latency.
# Set to 'false' to connect to live Supabase and FastAPI backend services.
VITE_USE_MOCKS=true
