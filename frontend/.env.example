# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI Backend URL
VITE_BACKEND_URL=http://localhost:8000

# Mock Services Switch
# Set to 'true' to develop UI offline with realistic mock data and simulated latency.
# Set to 'false' to connect to live Supabase and FastAPI backend services.
VITE_USE_MOCKS=true

# Mock Role Bypass (Can also be set in .env.local):
# Set to 'student', 'moderator', or 'admin' to bypass the login screen completely in mock mode.
# Leave blank to test the interactive login screen.
VITE_MOCK_ROLE=

# Example test accounts for Mock Mode (Password for all: password123):
# - student@campushub.edu   (Alex Chen, student)
# - moderator@campushub.edu (Morgan Taylor, moderator)
# - admin@campushub.edu     (Dr. Sarah Vance, admin)
