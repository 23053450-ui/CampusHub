{
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/features/communities/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/features/daily-quiz/**",
                  "@/features/dashboard/**",
                  "@/features/project-analysis/**",
                  "@/features/resume-reviewer/**",
                  "@/features/subjects/**",
                  "../daily-quiz/**",
                  "../dashboard/**",
                  "../project-analysis/**",
                  "../resume-reviewer/**",
                  "../subjects/**"
                ],
                "message": "Files in features/communities may not import from other features. Files in features/* may import only from components/ui, lib/, shared/ and their own folder."
              }
            ]
          }
        ]
      }
    },
